# ──────────────────────────────────────────────────────────────────────────
# Auren Care · variáveis de ambiente (TEMPLATE)
# Copie para .env.local e preencha os <...>. NUNCA commite valores reais.
# Em produção, os valores reais vivem só no Secret `aurencare-secrets` (k8s).
# ──────────────────────────────────────────────────────────────────────────

# ───────────── NextAuth ─────────────
# Gere com: openssl rand -base64 48
NEXTAUTH_SECRET=<gere-um-segredo-longo>
NEXTAUTH_URL=https://app.audere.ia.br

# ───────────── Banco / Cache ─────────────
DATABASE_URL=postgresql://aurencare:<SENHA>@postgres-service.postgresql.svc.cluster.local:5432/aurencare
REDIS_URL=redis://redis.database.svc.cluster.local:6379

# ───────────── Cripto (dados clínicos em repouso · AES-256) ─────────────
# 32 bytes em hex (64 chars). Gere com: openssl rand -hex 32
# ATENÇÃO: trocar esta chave torna dados já cifrados ilegíveis.
ENCRYPTION_KEY=<64-hex-chars>

# ───────────── IA / LLM (OpenAI primário · Anthropic fallback) ─────────────
# OpenAI é o provedor primário das chamadas de IA. ⚠️ Por carregar dados
# clínicos do paciente, exige Zero Data Retention (ZDR) + DPA com a OpenAI
# para honrar LGPD/CFP e a promessa "zero data training" da UI.
OPENAI_API_KEY=sk-proj-...
# Anthropic é o fallback (assume quando a OpenAI falha/timeouta). Mantenha
# configurado para resiliência em produção.
ANTHROPIC_API_KEY=sk-ant-...

# ───────────── WhatsApp / Evolution API ─────────────
EVOLUTION_API_URL=http://evolution-api-service.evolution.svc.cluster.local:8080
EVOLUTION_API_KEY=<evolution-api-key>
# Nome EXATO da instância no servidor Evolution (case-sensitive). Hoje é a
# instância compartilhada "Automaxia" (mesmo número do Habilita). Nome errado
# aqui = 404 no envio. Confirme em /admin/whatsapp ou via /instance/fetchInstances.
EVOLUTION_INSTANCE_NAME=Automaxia
# Token compartilhado p/ autenticar o webhook (header x-webhook-token ou ?token=).
# Gere com: openssl rand -hex 24
EVOLUTION_WEBHOOK_TOKEN=<gere-um-token>

# ───────────── WhatsApp / Cloud API (Meta) ─────────────
# Provider de saída: `evolution` (legado, instância compartilhada) ou `meta`
# (Cloud API oficial — número próprio da Audere, +55 61 94758-1770, WABA
# "Automaxia para Negócios"). Só esta env troca; as chamadas não mudam.
WHATSAPP_PROVIDER=evolution
# Token PERMANENTE de usuário do sistema (Business Suite → Usuários do sistema →
# gerar token → app "[Automaxia] Cloud API" → whatsapp_business_messaging +
# whatsapp_business_management). Token do painel de dev expira em 24h — não use.
META_WA_TOKEN=<token-usuario-do-sistema>
# IDs (Gerenciador do WhatsApp → Números de telefone → clique no número).
META_WA_PHONE_NUMBER_ID=1273053965895712
META_WA_WABA_ID=512053311999451
# App Secret (developers.facebook.com → app → Configurações → Básico). Assina o webhook.
META_APP_SECRET=<app-secret>
# Handshake do webhook (qualquer string; a mesma vai no painel do app). openssl rand -hex 24
META_WEBHOOK_VERIFY_TOKEN=<gere-um-token>
# META_GRAPH_VERSION=v22.0

# ───────────── Pagar.me ─────────────
PAGARME_API_KEY=sk_live_...
PAGARME_WEBHOOK_SECRET=<webhook-secret-do-painel-pagarme>
# Public key (pk_) p/ tokenizar o cartão da ASSINATURA no browser (API v5).
# ⚠️ NEXT_PUBLIC_* é INLINADO no BUILD — precisa estar no `next build`
# (passe via --build-arg, ver build-push.sh), não só no secret de runtime.
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=pk_live_...

# ───────────── Transcrição (AssemblyAI) ─────────────
ASSEMBLYAI_API_KEY=<assemblyai-key>

# ───────────── Email (Resend) ─────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Auren Care <contato@automaxia.com.br>

# ───────────── Cron (jobs HTTP protegidos) ─────────────
# Bearer exigido por /api/cron/*. Gere com: openssl rand -hex 24
CRON_SECRET=<gere-um-segredo>

# ───────────── Público (browser) · opcional ─────────────
NEXT_PUBLIC_APP_NAME=Auren Care
NEXT_PUBLIC_WS_URL=wss://app.audere.ia.br
